# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

app_ios_deployment_target = Gem::Version.new('15.1')
platform :ios, app_ios_deployment_target.version
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Discourse' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Branded app targets share the same pods as Discourse
  target 'Navodians' do
    inherit! :complete
  end

  target 'NITians' do
    inherit! :complete
  end

  target 'APEX' do
    inherit! :complete
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # RN 0.80's bundled fmt uses consteval, which requires C++20.
    # Let react-native's own build settings drive the C++ standard (gnu++20).
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings.delete('CLANG_CXX_LANGUAGE_STANDARD')
      end
    end

    # Xcode 26's Apple Clang is stricter about consteval than fmt 11.x expects.
    # Patch fmt's base header to force FMT_USE_CONSTEVAL=0 before fmt checks it,
    # so all consteval calls fall back to constexpr (safe on all compilers).
    # Xcode 26's Apple Clang is stricter about consteval than fmt 11.x expects.
    # The Apple clang guard in fmt only covers < 14; extend it to all Apple clang.
    fmt_base_header = File.join(installer.sandbox.root, 'fmt/include/fmt/base.h')
    if File.exist?(fmt_base_header)
      content = File.read(fmt_base_header)
      FileUtils.chmod('u+w', fmt_base_header)
      patched = content.gsub(
        /defined\(__apple_build_version__\) && __apple_build_version__ < 14000029L\n#\s*define FMT_USE_CONSTEVAL 0\s*\/\/ consteval is broken in Apple clang < 14\./,
        "defined(__apple_build_version__)\n#  define FMT_USE_CONSTEVAL 0  // consteval has evaluation issues with Apple clang."
      )
      if patched != content
        File.write(fmt_base_header, patched)
        puts 'Patched fmt/base.h: disabled consteval for all Apple clang (Xcode 26 workaround)'
      end
    end
  end

  # https://stackoverflow.com/questions/78993520/invalid-executable-the-executable-appname-app-frameworks-hermes-framework-herm
  bitcode_strip_path = `xcrun --find bitcode_strip`.chop!
    def strip_bitcode_from_framework(bitcode_strip_path, framework_relative_path)
      framework_path = File.join(Dir.pwd, framework_relative_path)
      command = "#{bitcode_strip_path} #{framework_path} -r -o #{framework_path}"
      puts "Stripping bitcode: #{command}"
      system(command)
    end

    framework_paths = [
      "Pods/hermes-engine/destroot/Library/Frameworks/macosx/hermes.framework/hermes",
      "Pods/hermes-engine/destroot/Library/Frameworks/macosx/hermes.framework/Versions/Current/hermes",
      "Pods/hermes-engine/destroot/Library/Frameworks/universal/hermes.xcframework/ios-arm64/hermes.framework/hermes",
      "Pods/hermes-engine/destroot/Library/Frameworks/universal/hermes.xcframework/ios-arm64_x86_64-maccatalyst/hermes.framework/hermes"
    ]

    framework_paths.each do |framework_relative_path|
      strip_bitcode_from_framework(bitcode_strip_path, framework_relative_path)
    end

end